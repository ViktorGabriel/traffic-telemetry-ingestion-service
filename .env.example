# Server Configuration
PORT=3333
HOST=0.0.0.0
NODE_ENV=development
LOG_LEVEL=info

# PostgreSQL Configuration (Partitioned Time-Series Storage)
PG_HOST=127.0.0.1
PG_PORT=5432
PG_DATABASE=traffic_telemetry
PG_USER=postgres
PG_PASSWORD=postgres
PG_POOL_MAX=20

# Redis Configuration (Streams / PubSub)
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
TELEMETRY_STREAM_NAME=traffic:telemetry:stream
MAX_STREAM_LEN=1000000
CONSUMER_GROUP_NAME=traffic-analytics-group

# Anomaly Detection Sliding Window Parameters
SPEED_THRESHOLD_KMH=100
CONSECUTIVE_SPEEDING_THRESHOLD=3
SIGNAL_LOSS_TIMEOUT_MS=60000
