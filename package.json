{
  "name": "traffic-telemetry-ingestion-service",
  "version": "1.0.0",
  "description": "High-throughput traffic telemetry and incident ingestion microservice",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "start": "node dist/server.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "keywords": [
    "fastify",
    "telemetry",
    "concurrency",
    "redis-streams",
    "clean-architecture",
    "zod"
  ],
  "author": "Viktor Gabriel",
  "license": "MIT",
  "dependencies": {
    "@fastify/websocket": "^11.3.7",
    "fastify": "^5.2.1",
    "ioredis": "^5.6.0",
    "pg": "^8.23.1",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/node": "^22.13.10",
    "@types/pg": "^8.23.1",
    "@types/ws": "^8.18.2",
    "@vitest/coverage-v8": "^3.2.7",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2",
    "vitest": "^3.0.8"
  }
}
